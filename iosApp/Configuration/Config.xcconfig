// Base build settings for the iOS app and its tests (add-ios-app-shell design, decisions 2 and 3).

// The Shared framework that the "Build Shared framework" phase has Gradle write before compiling.
// Static, so it links in; it needs the system SQLite that Room's iOS driver uses.
FRAMEWORK_SEARCH_PATHS = $(inherited) $(SRCROOT)/../shared/build/xcode-frameworks/$(CONFIGURATION)/$(SDK_NAME)
OTHER_LDFLAGS = $(inherited) -framework Shared -lsqlite3

// The Gradle phase writes outside the script sandbox.
ENABLE_USER_SCRIPT_SANDBOXING = NO

// Matches Android's versionName / versionCode. The bundle version reaches the BFF as X-APP-VERSION.
MARKETING_VERSION = 1.0
CURRENT_PROJECT_VERSION = 2

// TMDB v4 read access token, injected into Info.plist as TMDBReadAccessToken. Empty by default:
// the app still builds and TMDB calls return 401, as on Android without the token.
TMDB_READ_ACCESS_TOKEN =

// Per-developer values, git-ignored. Optional, so a fresh checkout still builds.
#include? "Secrets.xcconfig"
