// Copy to Secrets.xcconfig (git-ignored) and fill in your TMDB v4 read access token.
// xcconfig treats "//" as a comment, so a token never contains one; paste it as is.
TMDB_READ_ACCESS_TOKEN =

// For "Continue with Google": the REVERSED_CLIENT_ID value from iosApp/iosApp/GoogleService-Info.plist
// (com.googleusercontent.apps.…). That key is only there if the plist was downloaded after the Google
// provider was enabled in the Firebase console.
GOOGLE_REVERSED_CLIENT_ID =
