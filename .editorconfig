root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{kt,kts}]
# ktlint derives all of its rules from this file.
ktlint_code_style = ktlint_official
indent_style = space
indent_size = 4
max_line_length = 120
ij_kotlin_allow_trailing_comma = true
ij_kotlin_allow_trailing_comma_on_call_site = true

# @Composable functions are PascalCase by convention — exempt them from the
# camelCase function-naming rule (and from Preview functions' trailing names).
ktlint_function_naming_ignore_when_annotated_with = Composable, Preview

# Fires on files with a single top-level declaration whose name differs from it
# (e.g. Destinations.kt holding `Routes`). Grouping-by-purpose file names are
# intentional here, so this rule is off rather than forcing renames.
ktlint_standard_filename = disabled

[*.{yml,yaml,json,toml}]
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false
